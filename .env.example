NAME=claude-code
USERNAME=claude
CLAUDE_DIR=~/claude
CONTAINER_ROOT_PASSWORD=secure-password-change-this

# Extra host directories to share with Claude (comma-separated).
# Entry format: host_path[:container_path][:ro|rw]
# Without container_path the directory is mounted at /workspace/<folder name>.
# Example: EXTRA_VOLUMES=~/Dev/my-app,~/Notes/k8s:/workspace/notes:ro
EXTRA_VOLUMES=

# Optional: force the container user's UID/GID.
# Defaults: UID of the user running run.py, GID of CLAUDE_DIR.
# LOCAL_UID=
# LOCAL_GID=
